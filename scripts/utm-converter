#!/usr/bin/env python

import argparse
import sys

import utm


def format_latlon(latitude, longitude):
    # ~0.01 mm at the equator; enough headroom for the library's sub-mm accuracy
    return "{:.10f},{:.10f}".format(latitude, longitude)


def format_utm(easting, northing, zone_number, zone_letter):
    # 0.000001 m (micrometre), better than millimetre precision
    return "{:.6f},{:.6f},{},{}".format(
        easting, northing, zone_number, zone_letter
    )


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Bidirectional UTM/GRS80 converter for Python",
    )
    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
        metavar="COMMAND",
        help="Conversion direction",
    )

    parser_latlon = subparsers.add_parser(
        "latlon",
        help="Convert a latitude/longitude pair (GRS80) to UTM",
    )
    parser_latlon.add_argument(
        "latitude",
        type=float,
        help="Latitude of the GRS80 coordinate (degrees)",
    )
    parser_latlon.add_argument(
        "longitude",
        type=float,
        help="Longitude of the GRS80 coordinate (degrees)",
    )

    parser_utm = subparsers.add_parser(
        "utm",
        help="Convert a UTM coordinate to latitude/longitude (GRS80)",
    )
    parser_utm.add_argument(
        "easting",
        type=float,
        help="Easting component of the UTM coordinate (metres)",
    )
    parser_utm.add_argument(
        "northing",
        type=float,
        help="Northing component of the UTM coordinate (metres)",
    )
    parser_utm.add_argument(
        "zone_number",
        type=int,
        help="Zone number of the UTM coordinate",
    )
    parser_utm.add_argument(
        "zone_letter",
        help="Zone letter of the UTM coordinate",
    )

    args = parser.parse_args(argv)

    if args.command == "utm":
        latitude, longitude = utm.to_latlon(
            args.easting, args.northing, args.zone_number, args.zone_letter
        )
        print(format_latlon(latitude, longitude))
    elif args.command == "latlon":
        easting, northing, zone_number, zone_letter = utm.from_latlon(
            args.latitude, args.longitude
        )
        print(format_utm(easting, northing, zone_number, zone_letter))
    else:
        parser.error("unknown command")

    return 0


if __name__ == "__main__":
    sys.exit(main())
